# ==============================================================================
# Environment Configuration Template for AI-Powered Smart PDS
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# Application Runtime Mode ('development' or 'production')
FLASK_ENV=production
DEBUG=False
# Preferred web host port (launchers automatically fall back to another free port if occupied)
PORT=5000

# Security: Set a long, random secret key in production
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# Optional: Bootstrap key for initial admin registration via API when DB is empty
# BOOTSTRAP_ADMIN_KEY=your_secure_bootstrap_key_here

# MongoDB Configuration
# Default for Docker Compose execution (connects using container service hostname):
MONGO_URI=mongodb://mongo:27017/smart_pds_db
DB_NAME=smart_pds_db
# Preferred MongoDB host port binding (launchers automatically fall back to another free port if occupied)
MONGO_PORT_BINDING=127.0.0.1:27018

# For Native Local Python execution (uncomment if running without Docker):
# MONGO_URI=mongodb://localhost:27017/smart_pds_db
# DB_NAME=smart_pds_db

# Testing Database Configuration (isolated from production/demo database)
# TEST_MONGO_URI=mongodb://localhost:27017/smart_pds_test_db
# TEST_DB_NAME=smart_pds_test_db

# Machine Learning & Logging Settings
MODEL_DIR=backend/ml/saved_models
DATA_DIR=backend/ml/data
LOG_LEVEL=INFO
